{
  "name": "@t-jarpis/auth",
  "version": "0.3.0",
  "description": "Inloggen via Zitadel (OIDC): BFF-flow met versleutelde sessiecookie, en tokencontrole voor de API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
